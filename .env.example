# ============================================
# 应用基础配置
# ============================================
NODE_ENV=development
APP_PORT=8787

# ============================================
# 数据库提供商（二选一）
# ============================================
# d1（默认，Cloudflare D1）| mysql（自建，如阿里云 RDS）
# 切换到 mysql 时，下方 D1 / CLOUDFLARE_ACCOUNT_ID 仅迁移脚本需要，运行时不再读取
DB_PROVIDER=d1

# --- MySQL 数据库（DB_PROVIDER=mysql 时必填）---
# 数据库建议使用 utf8mb4 字符集；表结构会在服务首次启动时自动创建
# DB_MYSQL_HOST=127.0.0.1
# DB_MYSQL_PORT=3306
# DB_MYSQL_USER=nav
# DB_MYSQL_PASSWORD=your-password
# DB_MYSQL_DATABASE=diy_nav
# DB_MYSQL_CONNECTION_LIMIT=10

# ============================================
# Cloudflare 账号配置（DB_PROVIDER=d1 时必填）
# ============================================
# Cloudflare Account ID（D1 数据库 API 需要）
CLOUDFLARE_ACCOUNT_ID=xxxxxx

# --- Cloudflare D1 数据库 ---
DB_D1_API_TOKEN=xxxxxxx
DB_D1_DATABASE_ID=xxxxxxx

# --- D1 → MySQL 一次性数据迁移 ---
# 先配好上方 MySQL，再在 apps/api 目录执行：
#   DB_PROVIDER=mysql DB_MYSQL_HOST=... DB_MYSQL_PORT=... DB_MYSQL_USER=... \
#   DB_MYSQL_PASSWORD=... DB_MYSQL_DATABASE=... 
# pnpm migrate:d1-to-mysql
# 迁移完成并把 DB_PROVIDER 切到 mysql 后，本段 D1 配置可删除

# ============================================
# 安全密钥（必须在服务启动前就有，无法放到数据库）
# ============================================
# JWT 密钥，建议：openssl rand -base64 32
JWT_SECRET=xxxxxxx

# 数据库中 OAuth 密钥、SMTP 密码等敏感字段的加密密钥
# ⚠️ 生产环境必须修改，至少 32 位随机字符串
OAUTH_CONFIG_ENCRYPTION_KEY=xxxxxxxx

# ============================================
# 图标服务配置（供 icon-core 核心包读取，无法放到数据库）
# ============================================
ICON_SIZE=64
ICON_DEFAULT_URL=/icons/default.svg
# 国内可替换为自建代理：https://favicons.example.com/
ICON_GOOGLE_PROXY_URL=https://favicons.xxxxx.top/

# ============================================
# 日志配置
# ============================================
LOG_HEADERS=false
# 可选：LOG_LEVEL=info

# ============================================
# 前端构建配置（打包时写入 HTML/JS，运行时无法读取数据库）
# ============================================
VITE_API_BASE_URL=/api
VITE_BASE=/
VITE_USE_HASH_ROUTER=false
VITE_AUTO_BACKUP_INTERVAL=60000

# ============================================
# ⚠️ 以下配置已迁移到管理后台数据库，请在后台配置，无需在此填写：
#   - 站点名称、应用外部访问地址
#   - SMTP 邮件服务（账号、密码）
#   - AI 提供商（API Key、Base URL、模型）
#   - 对象存储（R2/S3/WebDAV 凭据、Bucket、路径）
# ============================================
